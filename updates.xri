<xri version="1.0">
   <description>
      <p>Masters of PixInsight V8 Scripts — ported and maintained by Peter Proulx,
      Masters of PixInsight (www.mastersofpixinsight.com).</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="MoPV8Scripts-1.5.4.tar.gz"
               sha1="c15ed070667ceb95e8916fb9774ad82ccfad0798"
               type="script"
               releaseDate="20260726">
         <title>Masters of PixInsight V8 Scripts v1.5.4</title>
         <description>
            <p>v1.5.4 — Added SHO-AIP (original work by Laurent Bourgon,
            Philippe Bernhard &amp; Dave Watson): a Multichannel Synthesis
            utility for mixing SHONRVB narrowband channels with an optional
            Luminance layer using the AIP method, with live preview,
            adjustable blend ratios per channel, background
            auto-equalization, and save/load of channel mix presets. 28
            scripts total.</p>
         </description>
      </package>
   </platform>
