   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="MoPV8Scripts-1.5.11.tar.gz"
               sha1="27312f7212a83e8f8877412dcc8ddaf67ce6f83c"
               type="script"
               releaseDate="20260823">
         <title>Masters of PixInsight V8 Scripts v1.5.11</title>
         <description>
            <p>v1.5.11 — Fixed PSFImage's OK button, which threw a silent
            "dialog is not defined" error and never closed the dialog. It
            was relying on a with()-block scope resolution
            (Control.dialog) that didn't survive the with() expansion
            during the V8 port. 35 scripts total.</p>
         </description>
      </package>
   </platform>
