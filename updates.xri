   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="MoPV8Scripts-1.5.8.tar.gz"
               sha1="2d77402fe28140793c0d85272835d7f1586f55dd"
               type="script"
               releaseDate="20260815">
         <title>Masters of PixInsight V8 Scripts v1.5.8</title>
         <description>
            <p>v1.5.8 — Added ColorMask (original work by Rick Stevenson):
            builds a mask selecting a specific hue range from an RGB image,
            with preset color buttons, three mask types (Chrominance,
            Lightness, Linear), a strength slider, and optional
            wavelet-based mask blur. 33 scripts total.</p>
         </description>
      </package>
   </platform>
