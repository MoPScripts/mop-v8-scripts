<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Masters of PixInsight V8 Scripts — ported and maintained by Peter Proulx,
      Masters of PixInsight (www.mastersofpixinsight.com).</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="MoPV8Scripts-1.5.9.tar.gz"
               sha1="3e12f56c7fa21c72687c5753114c895656cc245f"
               type="script"
               releaseDate="20260817">
         <title>Masters of PixInsight V8 Scripts v1.5.9</title>
         <description>
            <p>v1.5.9 — Added EmissionLineIntegration (original work by
            Hartmut V. Bornemann): continuum subtraction for
            narrowband-enhanced RGB images, isolating true emission-line
            signal from continuum bleed-through and neighboring-line
            contamination, with automatic per-channel ratio evaluation via
            curve-fitting, optional star-mask support, and an optional
            graphical analysis mode. 34 scripts total.</p>
         </description>
      </package>
   </platform>
</xri>
