<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Masters of PixInsight V8 Scripts — ported and maintained by Peter Proulx,
      Masters of PixInsight (www.mastersofpixinsight.com).</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="MoPV8Scripts-1.5.6.tar.gz"
               sha1="c06137663d928c6233aec16b0ee6d3973c62da65"
               type="script"
               releaseDate="20260805">
         <title>Masters of PixInsight V8 Scripts v1.5.6</title>
         <description>
            <p>v1.5.6 — Added ColorCorrectedHDRMT (original work by Russell
            Croman): an HDRMultiscaleTransform enhancement that uses the
            original image's HSI hue and saturation to preserve color
            through HDR compression, with adjustable layers, iterations,
            overdrive, lightness masking, and blend opacity. Ported without
            an external file dependency on AdP/CommonUIControls.js -- the
            one control it needed from that file is now defined locally.
            29 scripts total.</p>
         </description>
      </package>
   </platform>
</xri>
